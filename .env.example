# ModelGate 环境配置示例。复制为 .env 后按需修改，.env 已被 gitignore，不会提交。
# 生成上游 Key 加密主密钥（master_key）：
#   .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# 当前入口 app.prod_main 使用 PostgreSQL 和真实上游；旧 SQLite Demo 已移除。
MODE=prod

# PostgreSQL（对应 docker-compose.yml 映射到宿主机的 15435 端口）
DATABASE_URL=postgresql+asyncpg://modelgate:modelgate@127.0.0.1:15435/modelgate

# Redis 预留配置（对应 Compose 的 16381 端口）；应用尚未接入 Redis。
REDIS_URL=redis://127.0.0.1:16381/0

# 上游 Key 加密主密钥（Fernet）。留空则启动时报错，提示生成。
MASTER_KEY=

# 管理员账号和密码（本地默认值；部署前请改为强密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
# 未配置 ADMIN_TOKEN 时，服务启动会随机生成管理令牌。

# 上游渠道和公开模型由管理员在渠道管理页统一配置，不放入服务器 .env。
# 普通用户只读取共享渠道并通过自己的虚拟密钥调用；上游仅允许公网 HTTPS。

# 网关行为
MAX_ATTEMPTS=3
REQUEST_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=5
